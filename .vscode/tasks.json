{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run",
            "type": "shell",
            "command": "sh",
            "args": [
                "-c",
                "touch input.txt output.txt && g++ -std=c++17 -o \"${fileBasenameNoExtension}\" \"${fileBasename}\" && ./\"${fileBasenameNoExtension}\" < input.txt > output.txt"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
